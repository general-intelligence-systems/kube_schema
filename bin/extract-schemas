#!/usr/bin/env ruby

require 'json'

@kube_versions = %w[
  v1.19
  v1.21
  v1.31
  v1.32
  v1.33
  v1.34
  v1.35
]

@kube = {}

@kube_versions.map do |version|
  definitions =
    JSON.parse(`jq -r '.definitions' 'data/orig/k8s-#{version}.json'`)
      .map { |key, value| [key, value] }.to_h

  #definitions.keys.map do |line|
  #  line
  #    .gsub("io.k8s.api.", "")
  #    .gsub("io.k8s.apiextensions-apiserver.pkg.apis.", "")
  #    .gsub("io.k8s.apimachinery.pkg.apis.", "")
  #    .gsub("io.k8s.apimachinery.pkg.apis.", "")
  #    .gsub("io.k8s.kube-aggregator.pkg.apis.", "")
  #end.reject do |line|
  #  line.include?('RawExtension') ||
  #  line.include?('IntOrString') ||
  #  line.include?('version.Info') ||
  #  line.include?('resource.Quantity')
  #end

  @kube[version] = definitions
end

@kube.each do |version, definitions|
  `mkdir -p data/k8s.io/#{version}`
  `mkdir -p data/k8s.io/#{version}/definitions`

  count = 0
  definitions.each do |name, data|
    gvk = data["x-kubernetes-group-version-kind"]

    if gvk.is_a?(Array)
      gvk = gvk.first
      if gvk["group"].length < 1
        gvk["group"] = "core"
        `mkdir -p data/k8s.io/#{version}/#{gvk['group']}/#{gvk['version']}`
        gvk = "core/#{gvk["version"]}/#{gvk["kind"]}"
      else
        `mkdir -p data/k8s.io/#{version}/#{gvk['group']}/#{gvk['version']}`
        gvk = "#{gvk["group"]}/#{gvk["version"]}/#{gvk["kind"]}"
      end

      File.write "data/k8s.io/#{version}/#{gvk}.json", JSON.generate(data)
    else
      gvk = name
      File.write "data/k8s.io/#{version}/definitions/#{gvk}.json", JSON.generate(data)
    end

    #if gvk
    #  gvk = "#{gvk["group"]}.#{gvk["version"]}.#{gvk["kind"]}"
    #else
    #  gvk = name
    #    .gsub("io.k8s.api.", "")
    #    .gsub("io.k8s.apiextensions-apiserver.pkg.apis.", "")
    #    .gsub("io.k8s.apimachinery.pkg.apis.", "")
    #    .gsub("io.k8s.apimachinery.pkg.api.", "")
    #    .gsub("io.k8s.apimachinery.pkg", "")
    #    .gsub("io.k8s.kube-aggregator.pkg.apis.", "")
    #end

    #puts gvk

  end
end

