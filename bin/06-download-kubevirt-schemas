#!/usr/bin/env bash
#
# Downloads the KubeVirt OpenAPI swagger spec from GitHub and extracts all
# KubeVirt-specific definitions (everything not under k8s.io).
#
# This is needed because KubeVirt types are served via an aggregated API
# server (not regular CRDs), so they can't be extracted by applying CRD
# YAMLs to k3s like bin/04-get-crd-json does.
#
# Output: data/crds/08-kubevirt-definitions.json
#

set -euo pipefail

SWAGGER_URL="https://raw.githubusercontent.com/kubevirt/kubevirt/refs/heads/main/api/openapi-spec/swagger.json"
SWAGGER_FILE="data/crds/08-kubevirt-full-swagger.json"
OUTPUT_FILE="data/crds/08-kubevirt-definitions.json"

mkdir -p data/crds

echo "Downloading kubevirt swagger.json..."
curl -fsSL "$SWAGGER_URL" -o "$SWAGGER_FILE"

echo "Extracting KubeVirt definitions (non-k8s.io)..."

# The KubeVirt swagger has no x-kubernetes-group-version-kind annotations.
# KubeVirt-specific definitions use prefixes like v1., v1alpha1., v1beta1.
# while vendored k8s types use k8s.io.* prefixes. Extract everything that
# is NOT a k8s.io dependency.
jq '
  .definitions | with_entries(select(.key | startswith("k8s.io.") | not))
' "$SWAGGER_FILE" > "$OUTPUT_FILE"

TOTAL_COUNT=$(jq 'length' "$OUTPUT_FILE")
echo "  Extracted $TOTAL_COUNT KubeVirt definitions"

# Clean up
rm -f "$SWAGGER_FILE"

OUTPUT_SIZE=$(du -h "$OUTPUT_FILE" | cut -f1)
echo "Done. Output: $OUTPUT_FILE ($OUTPUT_SIZE)"
