#!/usr/bin/env bash

export KUBECONFIG=./kubeconfig.yaml

mkdir -p data/crds

kubectl() {
  docker compose exec -T server kubectl --kubeconfig /output/kubeconfig.yaml "$@"
}

docker compose up -d
trap "docker compose down" EXIT

until kubectl get nodes &>/dev/null; do echo "waiting for nodes..."; sleep 2; done

kubectl get --raw /openapi/v2  | jq -r '.definitions | to_entries[].key' > data/crds/01-k8s-definitions-list.txt

kubectl apply --server-side --validate=false -f - < data/crds/00-all-crds.yaml
kubectl wait --for=condition=Established crd --all --timeout=60s
kubectl get --raw /openapi/v2 > data/crds/02-full-schema.json

kubectl get --raw /openapi/v2  | jq -r '.definitions | to_entries[].key' > data/crds/03-crds-definitions-list.txt

comm -23 \
  <(sort data/crds/03-crds-definitions-list.txt) \
  <(sort data/crds/01-k8s-definitions-list.txt) \
  > data/crds/04-crd-only-definitions-list.txt

jq --rawfile keys data/crds/04-crd-only-definitions-list.txt \
  '($keys | split("\n") | map(select(length > 0))) as $k |
   .definitions | with_entries(select(IN($k[]; .key)))' \
  data/crds/02-full-schema.json \
  > data/crds/05-crd-only-definitions.json
