#!/usr/bin/env ruby

GEM_ROOT = File.expand_path("..", __dir__)

require 'bundler/setup'
require 'yaml'
require 'async/http/internet/instance'

results = []

Sync do
  YAML.load_file(File.join(GEM_ROOT, 'data/crd-list.yaml')).then do |urls|
    urls.each do |url|
      Async::HTTP::Internet.get(url) do |response|
        # Fail loudly on a bad URL — otherwise the error body (e.g. GitHub's
        # "404: Not Found") gets concatenated into the CRD bundle as junk and
        # the missing CRDs vanish silently from the generated schema.
        unless response.success?
          warn "Failed to download CRD (#{response.status}): #{url}"
          exit 1
        end
        results << response.read
      end
    end
  end
end

results.join("\n---\n").then do |output|
  `mkdir -p data/crds`

  target = File.join(GEM_ROOT, "data", "crds", "00-all-crds.yaml")
  File.write(target, output)
end
